# Copy to .env (which is gitignored) and fill in whichever key you have.
# You need at least one. See docs/providers.md for the trade-off between them.

# Vercel AI Gateway passthrough (no waitlist). Used by --provider gateway, the default.
AI_GATEWAY_API_KEY=

# TypeSafe direct (requires an approved account). Used by --provider typesafe.
# Preferred for the audit: it is the only path that pins the model version.
TYPESAFE_API_KEY=
